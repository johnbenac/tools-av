#!/usr/bin/env python3
"""av-editor - Multi-source timeline editor with clapboard sync

Drop-in replacement for the original /opt/tools-av/av-editor/av-editor.

Key improvement:
- Avoids memory blow-ups by never splitting a single decoded stream into multiple
  future-consumed branches (a common ffmpeg filtergraph footgun with concat).
  Instead, we render in timeline "chunks" where the full compositing state is
  constant, and we seek inputs per-chunk.

Interface is intentionally identical:
  av-editor render <config> [-v] [--dry-run] [--force]
  av-editor --version
"""

from av_editor.cli import main


if __name__ == '__main__':
    raise SystemExit(main())
